<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <profiles>

    <!-- UDPv4 transport만 사용 -->
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_only_transport</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant
      profile_name="udp_only_participant"
      is_default_profile="true">

      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>

        <userTransports>
          <transport_id>udp_only_transport</transport_id>
        </userTransports>
      </rtps>

    </participant>

    <!-- Data Sharing delivery 비활성화 -->
    <data_writer
      profile_name="udp_only_writer"
      is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_writer>

    <data_reader
      profile_name="udp_only_reader"
      is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_reader>

  </profiles>

  <!-- Fast DDS intra-process delivery 비활성화 -->
  <library_settings>
    <intraprocess_delivery>OFF</intraprocess_delivery>
  </library_settings>

</dds>